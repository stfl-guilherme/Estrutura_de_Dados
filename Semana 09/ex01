def avaliar_operacao(operacao):
    try:
        resultado = eval(operacao)
        return resultado
    except:
        return "Operação inválida"

def menu():
    print("\nMenu:")
    print("1. Inserir operação na pilha (ex: 5+3, 7*2)")
    print("2. Retirar última operação (POP)")
    print("3. Mostrar última operação inserida (Topo)")
    print("4. Mostrar todas as operações pendentes")
    print("5. Sair")

def main():
    pilha = []

    while True:
        menu()
        opcao = input("Escolha uma opção (1-5): ")

        if opcao == '1':
            operacao = input("Digite a operação matemática: ")
            pilha.append(operacao)
            print("Operação '" + operacao + "' inserida na pilha.")

        elif opcao == '2':
            if pilha:
                removida = pilha.pop()
                print("Operação '" + removida + "' removida da pilha.")
            else:
                print("A pilha está vazia. Nada para remover.")

        elif opcao == '3':
            if pilha:
                topo = pilha[-1]
                resultado = avaliar_operacao(topo)
                print("Última operação: " + topo + " = " + str(resultado))
            else:
                print("A pilha está vazia.")

        elif opcao == '4':
            if pilha:
                print("\nOperações pendentes na pilha:")
                for i, op in enumerate(reversed(pilha), 1):
                    print(str(i) + ". " + op + " = " + str(avaliar_operacao(op)))
            else:
                print("A pilha está vazia.")

        elif opcao == '5':
            print("Encerrando o programa. Até mais!")
            break

        else:
            print("Opção inválida. Tente novamente.")

if __name__ == "__main__":
    main()
