def main():
    pilha = []
    for i in range(1, 21):
        pilha.append("Carro" + str(i))

    carro_desejado = input("Digite o nome do carro que deseja retirar (ex: Carro15): ")

    if carro_desejado not in pilha:
        print("Carro não encontrado.")
        return

    carros_retirados = []
    while pilha:
        carro = pilha.pop()
        carros_retirados.append(carro)
        if carro == carro_desejado:
            break

    print("\nCarros retirados:")
    for c in carros_retirados:
        print(c)

main()
